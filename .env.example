# Runtime mode: true = local DuckDB/SQLite (fully supported), false = Databricks adapters
DEV=true

# true = seeded oracle simulator for the agent stage (no API key needed, decisions labeled mock-oracle)
# false = live Anthropic API calls (requires ANTHROPIC_API_KEY)
MOCK_LLM=true

# Only used when MOCK_LLM=false
ANTHROPIC_API_KEY=

# Override the local data directory (default: data/local)
# CDP_DATA_DIR=
